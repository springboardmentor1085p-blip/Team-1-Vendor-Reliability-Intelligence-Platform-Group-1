# Database Configuration
POSTGRES_USER=vendoriq_user
POSTGRES_PASSWORD=vendoriq_secure_pass_2026
POSTGRES_DB=vendoriq_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://vendoriq_user:vendoriq_secure_pass_2026@db:5432/vendoriq_db

# JWT Security
SECRET_KEY=supersecretjwtkeythatisextremelysecureandlongenoughfor2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:4200,http://localhost:80

# Environment Mode
ENV_MODE=development

# SMTP Email Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=no-reply@vendoriq.com
SMTP_USE_TLS=true

# Twilio SMS Configuration
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# File Upload Settings
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
